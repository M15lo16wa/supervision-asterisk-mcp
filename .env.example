# ───────────────  Orchestration racine (docker compose)  ───────────────
# cp .env.example .env  puis  docker compose up -d

# --- Keycloak / PostgreSQL ---
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=changeme_use_a_strong_secret
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=changeme_use_a_strong_secret
KC_HOSTNAME=http://localhost:8080
KEYCLOAK_PORT=8080

# --- Realm / client MCP (doit correspondre à keycloak/realm-export/asterik-realm.json) ---
KEYCLOAK_REALM=asterik
KEYCLOAK_CLIENT_ID=mcp-server

# --- Serveur MCP ---
MCP_PORT=8000
LOG_LEVEL=INFO

# --- Asterisk (profil `asterisk`) ---
ASTERISK_HOST=asterisk
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=mcp_ami
ASTERISK_AMI_SECRET=changeme_ami
ASTERISK_ARI_BASE_URL=http://asterisk:8088
ASTERISK_ARI_USER=mcp_ari
ASTERISK_ARI_PASSWORD=changeme_ari

# --- Pipeline vocal S2S (profil `voice`) ---
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_KEEP_ALIVE=30m
STT_MODEL=small
STT_DEVICE=cpu
TTS_VOICE=fr_FR-siwis-medium
VOICE_RTP_PORT=40000
VOICE_METRICS_PORT=9092
LATENCY_BUDGET_MS=1500

# --- Observabilité (profil `monitoring`) ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Basic Auth de /metrics d'Asterisk — doit == asterisk/config/prometheus.conf
ASTERISK_METRICS_PASSWORD=changeme_metrics
