# cp .env.example .env  puis  docker compose up -d
# (docker-compose n'orchestre que PostgreSQL + Keycloak + serveur MCP ;
#  Asterisk / Ollama / Prometheus / Grafana sont des conteneurs externes)

# --- Keycloak / PostgreSQL ---
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=changeme_use_a_strong_secret
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=changeme_use_a_strong_secret
KC_HOSTNAME=http://localhost:8080
KEYCLOAK_PORT=8080

# --- Realm / client MCP (doit correspondre à keycloak/realm-export/asterik-realm.json) ---
KEYCLOAK_REALM=asterik
KEYCLOAK_CLIENT_ID=mcp-server

# --- Serveur MCP ---
MCP_PORT=8000
LOG_LEVEL=INFO
# keycloak (défaut) | static (jetons dev-operateur/superviseur/admin, sans Keycloak)
MCP_AUTH_MODE=keycloak
# URL publique -> métadonnée OAuth de ressource protégée (RFC 9728, OAuth 2.1 + PKCE)
MCP_PUBLIC_URL=http://localhost:8000
# pilotage (HITL sur origination/hangup/transfert/spy) | all (HITL sur TOUS les outils)
MCP_HITL_MODE=pilotage
# Journal d'audit JSON Lines (A.6)
AUDIT_LOG_PATH=logs/audit.jsonl

# --- Asterisk (conteneur externe joint au réseau supervision-net) ---
ASTERISK_HOST=asterisk
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=mcp_ami
ASTERISK_AMI_SECRET=changeme_ami
ASTERISK_ARI_BASE_URL=http://asterisk:8088
ASTERISK_ARI_USER=mcp_ari
ASTERISK_ARI_PASSWORD=changeme_ari
ASTERISK_DEFAULT_CONTEXT=internal
# Trunks reconnus par get_trunk_utilization (sinon : endpoints préfixés "trunk")
ASTERISK_TRUNKS=trunk-out
ASTERISK_TRUNK_MAX_TRUNK_OUT=10
# Basic Auth de /metrics d'Asterisk (== asterisk/config/prometheus.conf)
ASTERISK_METRICS_PASSWORD=changeme_metrics

# --- Pipeline vocal S2S — python -m src.voice.runner (Ollama externe) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
STT_MODEL=small
STT_DEVICE=cpu
TTS_VOICE=fr_FR-siwis-medium
VOICE_RTP_PORT=40000
VOICE_METRICS_PORT=9092
LATENCY_BUDGET_MS=1500
