# Configuration du serveur MCP lancé HORS Docker (python -m src.main).
# En Docker, ces valeurs viennent du .env racine via docker-compose.
# cp .env.example .env

# --- Authentification ---
# keycloak (défaut) : JWT OIDC vérifié contre Keycloak
# static            : jetons de dev (dev-operateur / dev-superviseur / dev-admin),
#                     pour tester sans Keycloak — JAMAIS en production
MCP_AUTH_MODE=keycloak

# --- Keycloak ---
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=asterik
KEYCLOAK_CLIENT_ID=mcp-server

# --- Asterisk AMI (outils Module 2) ---
ASTERISK_HOST=localhost
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=mcp_ami
ASTERISK_AMI_SECRET=changeme_ami

# --- Asterisk ARI (qualité RTCP, External Media) ---
ASTERISK_ARI_BASE_URL=http://localhost:8088
ASTERISK_ARI_USER=mcp_ari
ASTERISK_ARI_PASSWORD=changeme_ari
ASTERISK_ARI_APP=mcp-supervision
ASTERISK_DEFAULT_CONTEXT=internal

# --- Serveur MCP ---
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000

# --- Logging ---
LOG_LEVEL=INFO
