# cp .env.example .env  puis  docker compose up -d
# (stack de supervision : Ollama + Prometheus + Grafana, rattachée à
#  `supervision-net` créé par le docker-compose.yml racine)

# --- Ollama ---
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# --- Prometheus ---
PROMETHEUS_PORT=9090
# Doit correspondre au `auth_password` d'Asterisk
# (asterisk/config/prometheus.conf et .env racine ASTERISK_METRICS_PASSWORD).
# La valeur est injectée dans monitoring/prometheus/prometheus.yml (${VAR}).
ASTERISK_METRICS_PASSWORD=changeme_metrics

# --- Grafana ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3000

# --- Intégration Keycloak (optionnelle) ---
GRAFANA_OIDC_ENABLED=false
GRAFANA_OIDC_CLIENT_ID=grafana
GRAFANA_OIDC_CLIENT_SECRET=changeme
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=asterisk