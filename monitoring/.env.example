# cp .env.example .env  puis  docker compose up -d
# (stack de supervision : Ollama + Prometheus + Grafana, rattachée à
#  `supervision-net` créé par le docker-compose.yml racine)

# --- llama.cpp (alternative légère à Ollama) ---
# Le modèle GGUF doit être placé dans monitoring/models/model.gguf
# (voir monitoring/models/README.md pour le téléchargement).
OLLAMA_PORT=11434
# Nom du modèle tel que passé à llama.cpp (doit correspondre au fichier GGUF)
OLLAMA_MODEL=qwen2.5-0.5b-instruct-q4_k_m

# --- Prometheus ---
PROMETHEUS_PORT=9090
# Doit correspondre au `auth_password` d'Asterisk
# (asterisk/config/prometheus.conf et .env racine ASTERISK_METRICS_PASSWORD).
# Prometheus n'expanse pas ${VAR} dans basic_auth : le compose transforme donc
# cette variable en secret `asterisk_metrics_password`, monté en fichier et lu
# via `password_file` dans monitoring/prometheus/prometheus.yml.
ASTERISK_METRICS_PASSWORD=changeme_metrics

# --- Grafana ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3000

# --- Intégration Keycloak (optionnelle) ---
GRAFANA_OIDC_ENABLED=false
GRAFANA_OIDC_CLIENT_ID=grafana
GRAFANA_OIDC_CLIENT_SECRET=changeme
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=asterisk